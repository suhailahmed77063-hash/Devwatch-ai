# ─────────────────────────────────────────────────────────────────────────────
# WebForge AI — environment configuration
# Copy to `.env.local` and fill in values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL database (local dev: see docker-compose.yml)
DATABASE_URL="postgresql://webforge:webforge@localhost:5432/webforge?schema=public"

# ── Authentication (Auth.js / NextAuth v5) ───────────────────────────────────
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000" # legacy alias used by some libraries

# Email/password login works out of the box. OAuth providers are optional:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── AI providers (OpenAI-compatible) ─────────────────────────────────────────
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Groq, Together,
# Azure (set OPENAI_BASE_URL), Ollama (local), etc.
AI_PROVIDER="openai"            # openai | (future: anthropic, azure, ollama…)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_CHAT_MODEL="gpt-4o-mini"     # chat / agent reasoning
AI_GENERATION_MODEL="gpt-4o"    # heavy website generation
AI_IMAGE_MODEL="gpt-image-1"    # image provider model (OpenAI images API)

# ── Object storage (S3-compatible: AWS S3, R2, MinIO, Garage…) ───────────────
STORAGE_PROVIDER="local"        # local (dev) | s3
S3_REGION="us-east-1"
S3_BUCKET="webforge-assets"
S3_ENDPOINT=""                  # set for MinIO/R2 compatible endpoints
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""           # public CDN base for uploaded assets (optional)

# ── Deployment / hosting ─────────────────────────────────────────────────────
# WebForge can host published sites itself at WEBFORGE_APP_BASE (uses the
# application database as the origin). For external static hosting set
# DEPLOYMENT_PROVIDER=s3 (uploads generated artifacts to the bucket above).
DEPLOYMENT_PROVIDER="webforge"  # webforge | s3
WEBFORGE_APP_BASE="webforge.app"
WEBFORGE_SITE_BASE_URL=""       # e.g. https://your-domain.com (for canonical URLs)

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""

# ── Redis (optional; enables distributed rate limiting + job queue later) ────
REDIS_URL=""

# ── Email (optional; SMTP-compatible) ────────────────────────────────────────
# When unset, emails are logged to the server console (dev only).
EMAIL_PROVIDER="console"        # console | smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="WebForge AI <no-reply@webforge.app>"
APP_URL="http://localhost:3000"

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL="info"
SENTRY_DSN=""
