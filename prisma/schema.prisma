// ─────────────────────────────────────────────────────────────────────────────
// WebForge AI — Prisma schema
//
// Source-of-truth for a website is the structured WebsiteSchema JSON stored on
// Project.currentSchema and ProjectVersion.schema. The Page / Section /
// Component tables below are *queryable projections* of the current version
// (kept in sync by lib/server/versions.ts) so the dashboard, SEO engine and
// future analytics never parse full JSON blobs. Never treat them as
// authoritative content stores.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

enum ProjectStatus {
  DRAFT // no site yet
  GENERATING // AI pipeline running
  READY // schema exists, editable
  ARCHIVED
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  READY
  FAILED
  CANCELLED
}

enum GenerationKind {
  WEBSITE // full site from prompt
  EDIT // AI chat edit / patch
  IMAGE // image generation
  SEO // seo optimization pass
  CODE // code export generation
  REVIEW // review/audit pass
}

enum GenerationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum AssetKind {
  IMAGE
  VIDEO
  FILE
}

enum UsageKind {
  AI_GENERATION
  AI_TOKENS
  IMAGE_GENERATION
  CODE_EXPORT
  DEPLOYMENT
  STORAGE
  APP_GENERATION
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
  REMOVED
}

enum AppRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  CANCELLED
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

// ── Security Agent ──────────────────────────────────────────────────────────

enum SecurityRunKind {
  SCAN
  INVESTIGATE
  VALIDATE
  REMEDIATE
  VERIFY
  FULL
}

enum SecurityRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SecurityFindingStatus {
  QUEUED
  INVESTIGATING
  VALIDATION_REQUIRED
  VALIDATING
  CONFIRMED
  FALSE_POSITIVE
  REMEDIATION_READY
  FIXED
  VERIFIED
}

enum SecurityVerdict {
  CONFIRMED
  LIKELY
  POTENTIAL
  FALSE_POSITIVE
}

enum SecuritySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SecurityRepoSource {
  WORKSPACE
  LINKED_REPO
  GITHUB_LINK
}

enum SecurityAuthScope {
  NONE
  USER
  EXPLICIT
  SYSTEM
}

enum SecurityValidationStatus {
  PENDING
  RUNNING
  EXPLOITABLE
  NOT_EXPLOITABLE
  INCONCLUSIVE
  FAILED
  SKIPPED
}

enum SecurityPatchStatus {
  PROPOSED
  APPLIED
  DISCARDED
}

enum SecurityVerificationStatus {
  PENDING
  RUNNING
  FIXED
  STILL_VULNERABLE
  INCONCLUSIVE
  FAILED
}

// ── Auth (Auth.js Prisma adapter) ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // credentials provider only
  plan          Plan      @default(FREE)
  stripeCustomerId String? @unique

  accounts        Account[]
  sessions        Session[]
  subscriptions   Subscription[]
  usage           Usage[]
  ownedProjects   Project[]          @relation("ProjectOwner")
  collaborations  ProjectCollaborator[]
  generations     Generation[]
  conversations   AIConversation[]
  assetsOwned     Asset[]            @relation("AssetOwner")
  apiKeys         ApiKey[]
  appRuns         AppRun[]            @relation("AppRunAuthor")
  appCheckpoints  AppCheckpoint[]     @relation("AppCheckpointAuthor")
  auditLogs       AuditLog[]
  versionsCreated ProjectVersion[]   @relation("VersionAuthor")
  invitationsSent Invitation[]       @relation("InviteSender")
  invitationsAccepted Invitation[]   @relation("InviteAcceptor")
  securityRuns    SecurityRun[]      @relation("SecurityRunAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plan])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Billing & usage ─────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  plan                 Plan
  status               SubscriptionStatus
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// Monthly metered usage per kind. Rows upserted as actions happen.
model Usage {
  id        String     @id @default(cuid())
  userId    String
  kind      UsageKind
  month     String // "yyyy-mm"
  used      Int        @default(0)
  // meta carries optional detail snapshots, e.g. last token counts
  meta      Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, month])
  @@index([month])
}

// ── Projects ────────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique // webforge subdomain: {slug}.webforge.app
  description String?
  framework   String        @default("nextjs")
  status      ProjectStatus @default(DRAFT)

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // current schema (structured website JSON) + bump counter
  currentSchema      Json?
  currentVersionId   String?  @unique
  currentVersion     ProjectVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  aiConfig Json? // per-project AI overrides (enterprise): { provider?, model? }

  versions      ProjectVersion[]     @relation("ProjectVersions")
  pages         Page[]
  sections      Section[]
  components    Component[]
  assets        Asset[]
  generations   Generation[]
  deployments   Deployment[]
  domains       CustomDomain[]
  envVars       EnvironmentVariable[]
  collaborators ProjectCollaborator[]
  invitations   Invitation[]
  conversations AIConversation[]
  auditLogs     AuditLog[]
  appFiles      AppFile[]
  appRuns       AppRun[]
  appCheckpoints AppCheckpoint[]
  securityRuns        SecurityRun[]
  securityFindings    SecurityFinding[]
  securityActions     SecurityAction[]
  securityValidations SecurityValidation[]
  securityPatches     SecurityPatch[]
  securityVerifications SecurityVerification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([updatedAt])
}

// ── Security Agent ──────────────────────────────────────────────────────────
// Detect → Investigate → Safely Validate → Explain → Remediate → Verify.
// All rows hang off Project (the isolation unit): every read/write path goes
// through access.ts role checks, so project RBAC == org-level isolation.

// One invocation of the security agent pipeline.
model SecurityRun {
  id          String            @id @default(cuid())
  projectId   String
  kind        SecurityRunKind   @default(SCAN)
  status      SecurityRunStatus @default(QUEUED)
  repoSource  SecurityRepoSource @default(WORKSPACE)
  repoUrl     String? // github.com/owner/repo when scanned by link
  repoBranch  String? @default("main")
  fileCount   Int @default(0)
  findingCount Int @default(0)
  summary     String?
  error       String?
  tokensIn    Int @default(0)
  tokensOut   Int @default(0)
  durationMs  Int?
  createdById String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("SecurityRunAuthor", fields: [createdById], references: [id])
  findings  SecurityFinding[]
  actions   SecurityAction[]

  @@index([projectId, startedAt])
  @@index([status])
}

// A detected vulnerability with full AI investigation output.
model SecurityFinding {
  id         String               @id @default(cuid())
  runId      String
  projectId  String
  ruleId     String // scanner rule id, e.g. "sast.sql-injection"
  title      String
  category   String @default("sast") // sast | dependency | secret | config | authz
  severity   SecuritySeverity     @default(MEDIUM)
  confidence Int @default(50) // 0..100
  cwe        String? // e.g. CWE-89
  cve        String?
  filePath   String?
  lineStart  Int?
  lineEnd    Int?
  snippet    String? // redacted code evidence
  rootCause  String?
  evidence   Json? // [{ file, line?, excerpt }]
  impact     String?
  recommendation String?
  attackPath Json? // [{ label, detail, file?, line? }]
  components Json? // [{ name, version?, ecosystem }] for dependency findings
  verdict    SecurityVerdict?
  verdictReason String?
  aiAnalysis String?
  status     SecurityFindingStatus @default(QUEUED)
  fingerprint String // stable hash for dedupe across scans
  fixedAt    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  run       SecurityRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  validations SecurityValidation[]
  patches     SecurityPatch[]
  verifications SecurityVerification[]
  actions      SecurityAction[]

  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([projectId, fingerprint])
  @@index([runId])
}

// Authorized sandbox proof-of-concept validation of one finding.
model SecurityValidation {
  id         String                  @id @default(cuid())
  findingId  String
  projectId  String
  status     SecurityValidationStatus @default(PENDING)
  environment String @default("isolated-sandbox")
  authorized Boolean @default(false)
  authorizedById String?
  pocScript  String? // generated PoC (redacted, stored for audit)
  evidence   Json? // [{ label, output?, exitCode?, durationMs? }]
  output     String? // captured sandbox output (trimmed + redacted)
  exploitReproduced Boolean @default(false)
  durationMs Int?
  sandboxId  String?
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  finding SecurityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verifications SecurityVerification[]

  @@index([findingId, startedAt])
  @@index([projectId, startedAt])
}

// AI-generated proposed patch — never auto-merged; applied via GitHub workflow.
model SecurityPatch {
  id         String             @id @default(cuid())
  findingId  String
  projectId  String
  status     SecurityPatchStatus @default(PROPOSED)
  summary    String?
  rootCause  String?
  strategy   String?
  diff       String
  verificationPlan String?
  model      String?
  tokensIn   Int @default(0)
  tokensOut  Int @default(0)
  appliedAt  DateTime?

  finding SecurityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verifications SecurityVerification[]

  createdAt DateTime @default(now())

  @@index([findingId, createdAt])
}

// Re-scan + re-validation after a fix is applied (before/after comparison).
model SecurityVerification {
  id         String                    @id @default(cuid())
  findingId  String
  projectId  String
  patchId    String?
  revalidationId String?
  status     SecurityVerificationStatus @default(PENDING)
  beforeState String? // "VULNERABLE" — the original validated state
  rescan     Json? // { findingCount, reproduced, notes }
  testsPassed Boolean?
  testOutput String?
  remainingRisks Json?
  summary    String?
  error      String?
  durationMs Int?
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  finding     SecurityFinding     @relation(fields: [findingId], references: [id], onDelete: Cascade)
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  patch       SecurityPatch?      @relation(fields: [patchId], references: [id])
  revalidation SecurityValidation? @relation(fields: [revalidationId], references: [id])

  @@index([findingId, startedAt])
}

// Append-only audit trail of every agent tool invocation.
model SecurityAction {
  id         String             @id @default(cuid())
  projectId  String
  runId      String?
  findingId  String?
  actorId    String?
  tool       String // permission key, e.g. READ_REPOSITORY
  action     String // human label, e.g. "investigate finding"
  status     String @default("OK") // OK | DENIED | ERROR
  authScope  SecurityAuthScope @default(USER)
  authorized Boolean @default(false)
  environment String? // e.g. "isolated-sandbox"
  input      Json? // redacted input snapshot
  result     Json? // redacted result snapshot
  error      String?
  durationMs Int?

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run     SecurityRun?   @relation(fields: [runId], references: [id])
  finding SecurityFinding? @relation(fields: [findingId], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([runId])
  @@index([findingId])
}

model ProjectVersion {
  id         String   @id @default(cuid())
  projectId  String
  version    Int
  schema     Json // full structured WebsiteSchema at this point
  code       Json? // optional code snapshot summary { files, checksum }
  message    String? // human description of what changed
  createdById String?

  project   Project @relation("ProjectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("VersionAuthor", fields: [createdById], references: [id])
  // opposite side of Project.currentVersion
  currentForProject Project? @relation("CurrentVersion")

  createdAt DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

// Queryable projection of the current schema's pages (see header comment).
model Page {
  id        String @id @default(cuid())
  projectId String
  slug      String
  name      String
  order     Int    @default(0)
  seo       Json?  // { title, description, ogImage, jsonLd }
  sections  Section[]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([projectId])
}

// Queryable projection of the current schema's sections (see header comment).
model Section {
  id        String @id @default(cuid())
  projectId String
  pageId    String
  sectionId String // stable id of the section inside the schema document
  type      String // hero | features | pricing | ...
  order     Int    @default(0)
  title     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, sectionId])
  @@index([projectId])
}

// Queryable projection of global/reusable components (see header comment).
model Component {
  id        String @id @default(cuid())
  projectId String
  type      String // navbar | footer | ...
  name      String
  props     Json?
  order     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, type])
  @@index([projectId])
}

// ── Assets ──────────────────────────────────────────────────────────────────

model Asset {
  id         String    @id @default(cuid())
  projectId  String
  ownerId    String
  kind       AssetKind @default(IMAGE)
  name       String
  filename   String
  mimeType   String?
  size       Int       @default(0)
  width      Int?
  height     Int?
  storageKey String // provider-relative key, never a signed/private URL
  url        String? // public URL when available
  alt        String?
  isAiGenerated Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User    @relation("AssetOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([ownerId])
}

// ── AI ──────────────────────────────────────────────────────────────────────

model Generation {
  id         String           @id @default(cuid())
  projectId  String
  userId     String
  kind       GenerationKind
  status     GenerationStatus @default(QUEUED)
  prompt     String?
  // structured result summary (patch summary / schema metadata)
  result     Json?
  model      String?
  tokensIn   Int              @default(0)
  tokensOut  Int              @default(0)
  durationMs Int?
  error      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  finishedAt DateTime?

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model AIConversation {
  id        String @id @default(cuid())
  projectId String
  userId    String
  title     String @default("New conversation")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  messages AIMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model AIMessage {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  meta           Json? // tool usage, patch, token counts
  createdAt      DateTime    @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ── Deployments ─────────────────────────────────────────────────────────────

model Deployment {
  id          String           @id @default(cuid())
  projectId   String
  status      DeploymentStatus @default(QUEUED)
  provider    String // webforge | s3
  version     Int? // ProjectVersion deployed
  commitLabel String? // version marker shown in history
  url         String? // public URL when READY
  durationMs  Int?
  error       String?
  isPublished Boolean          @default(false)
  // built static artifact (WebForge hosting provider): page-path -> html
  artifact    Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs    DeploymentLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([status])
  @@index([isPublished, status])
}

model DeploymentLog {
  id           String   @id @default(cuid())
  deploymentId String
  level        String   @default("info") // info | warn | error
  message      String
  meta         Json?

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([deploymentId, createdAt])
}

// ── Domains & environment ───────────────────────────────────────────────────

model CustomDomain {
  id        String       @id @default(cuid())
  projectId String
  domain    String       @unique // apex or subdomain, lowercased
  status    DomainStatus @default(PENDING)
  // CNAME target to point at, e.g. {slug}.{WEBFORGE_APP_BASE}
  dnsTarget String?
  verifiedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model EnvironmentVariable {
  id        String  @id @default(cuid())
  projectId String
  name      String
  // encrypted at rest by lib/server/crypto.ts when valueCipher is used
  valueCipher String?
  isSecret  Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
}

// ── AI App Builder (Lovable-style) ───────────────────────────────────────────
// Virtual code workspace: the generated application is stored as structured
// file rows (never opaque blobs), synced to a real sandbox directory when
// tests/typecheck/build run.

model AppFile {
  id        String   @id @default(cuid())
  projectId String
  path      String // repo-relative, e.g. "src/app.ts" — never absolute
  content   String
  size      Int      @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
}

// One execution of the automated QA pipeline (or a single AI fix loop).
model AppRun {
  id          String       @id @default(cuid())
  projectId   String
  kind        String // generate | agent | manual | fix | full
  status      AppRunStatus @default(QUEUED)
  steps       Json? // [{ id, label, status, output, durationMs }]
  summary     String?
  error       String?
  createdById String?
  durationMs  Int?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("AppRunAuthor", fields: [createdById], references: [id])

  @@index([projectId, startedAt])
}

// Snapshot of the workspace before/after major AI modifications. Restoring a
// checkpoint replaces the file rows (new files are appended by path diff).
model AppCheckpoint {
  id         String   @id @default(cuid())
  projectId  String
  version    Int
  message    String
  files      Json // { path -> content } snapshot
  commitHash String?
  createdById String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("AppCheckpointAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

// ── Templates ───────────────────────────────────────────────────────────────

model Template {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  category    String // SaaS | Portfolio | E-commerce | ...
  description String
  coverImage  String?
  isPublic    Boolean @default(true)
  authorId    String?
  usedCount   Int     @default(0)

  versions TemplateVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model TemplateVersion {
  id           String @id @default(cuid())
  templateId   String
  version      Int
  schema       Json // WebsiteSchema
  theme        Json?
  seoDefaults  Json?

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([templateId, version])
}

// ── Collaboration ───────────────────────────────────────────────────────────

model ProjectCollaborator {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      Role   @default(VIEWER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Invitation {
  id           String           @id @default(cuid())
  projectId    String
  email        String
  role         Role             @default(VIEWER)
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  invitedById  String
  acceptedById String?
  expiresAt    DateTime

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("InviteSender", fields: [invitedById], references: [id])
  acceptedBy User?   @relation("InviteAcceptor", fields: [acceptedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([email])
}

// ── API keys ────────────────────────────────────────────────────────────────

model ApiKey {
  id         String      @id @default(cuid())
  userId     String
  name       String
  prefix     String // first 8 chars of the key (shown in UI)
  keyHash    String    @unique // sha256 of full key — plaintext is shown once
  status     ApiKeyStatus @default(ACTIVE)
  lastUsedAt DateTime?
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// ── Webhooks & audit ────────────────────────────────────────────────────────

model WebhookEvent {
  id        String        @id @default(cuid())
  provider  String // stripe | github | ...
  eventType String
  payload   Json?
  status    WebhookStatus @default(RECEIVED)
  processedAt DateTime?
  error     String?

  createdAt DateTime @default(now())

  @@index([provider, status])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  projectId String?
  action    String // e.g. project.update, project.delete, version.restore
  entity    String
  entityId  String?
  meta      Json?
  ip        String?

  actor   User?    @relation(fields: [actorId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}
